# ---------------------------------------------------------------
# NSK Technical Information Portal — environment template
# Copy to .env.local (development) or set in your hosting platform.
# ---------------------------------------------------------------

# PostgreSQL connection (local Postgres, Docker, Supabase, Neon, RDS…)
DATABASE_URL=postgres://localhost:5432/nsk_portal
DATABASE_POOL_MAX=10

# Public base URL of the portal (used in notification e-mails)
APP_URL=http://localhost:3000

# File storage: "local" keeps PDFs in a private folder (NOT under /public).
# Use "s3" for any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Supabase S3).
# The bucket must be PRIVATE — files are always streamed through the
# authenticated /api/files route, never via public bucket URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_MB=50
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=true

# E-mail notifications via Resend (https://resend.com). Leave blank to disable;
# publication events are still recorded and shown in the portal.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: Chrome/Chromium binary for server-side PDF export of authored documents.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Debian/Ubuntu (Docker image): /usr/bin/chromium
CHROME_EXECUTABLE_PATH=

# OCR for scanned PDFs (tesseract.js). Language data is downloaded once and cached.
OCR_CACHE_DIR=./storage/.ocr-cache
OCR_LANGS=eng

# ---------------------------------------------------------------
# Development seed accounts (npm run db:seed). TEST VALUES ONLY.
# In production create real accounts with `npm run user:create`.
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@nsk-portal.test
SEED_ADMIN_PASSWORD=Admin-Portal-2026!
SEED_DEALER_EMAIL=dealer@sample-dealer.test
SEED_DEALER_PASSWORD=Dealer-Portal-2026!

# Server time zone used to display dates (Docker: set TZ)
# TZ=Asia/Phnom_Penh
# Database password for docker-compose
# POSTGRES_PASSWORD=change-me
